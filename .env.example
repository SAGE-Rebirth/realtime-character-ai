# Google AI Studio key for Gemini Live (free tier is fine for demos; free-tier data may be used by Google).
# LIVE_MODEL_API_KEY is preferred; GEMINI_API_KEY is the fallback.
LIVE_MODEL_API_KEY=
# Gemini Live model id: check https://ai.google.dev/gemini-api/docs/models for current Live models.
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
GEMINI_API_VERSION=v1alpha
GEMINI_VOICE=Kore
# How much the model thinks before replying: minimal (fastest, default) | low | medium | high.
GEMINI_THINKING_LEVEL=minimal
# Silence (ms) before Gemini decides the user has finished speaking. Lower = snappier, but may cut people off.
TURN_SILENCE_MS=500

# Knowledge base (documents agents answer from). Embeddings use the Gemini key above.
# GEMINI_EMBED_MODEL=gemini-embedding-001
# Similarity below which a passage counts as unrelated to the question (depends on the model).
# KNOWLEDGE_MIN_SIMILARITY=0.58

# Local LiveKit server (infra/docker/compose.yaml runs it in dev mode with these keys)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Platform API
API_PORT=8787
STUDIO_ORIGIN=http://localhost:3100
NEXT_PUBLIC_API_URL=http://localhost:8787
